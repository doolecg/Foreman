#!/bin/sh
# Runs the foreman CLI with the Foreman app binary as Node (FOREMAN_NODE), or plain node.
# ELECTRON_RUN_AS_NODE is set only for that process, never in the operator's shell.
self=$(readlink -f -- "$0" 2>/dev/null) || self=$0
[ -n "$self" ] || self=$0
dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)
cli="$dir/foreman.cjs"
[ -f "$cli" ] || cli="$dir/../../out/cli/foreman.cjs"
if [ -n "$FOREMAN_NODE" ]; then
  ELECTRON_RUN_AS_NODE=1
  export ELECTRON_RUN_AS_NODE
  exec "$FOREMAN_NODE" "$cli" "$@"
fi
exec node "$cli" "$@"
